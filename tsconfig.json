{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["src", "tests", "wxt.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
